{
  "openapi": "3.1.0",
  "info": {
    "title": "US Baby Names API",
    "version": "1.0.0",
    "description": "Free, read-only access to US baby name counts and ranks from the Social Security Administration, 1880–2025. No authentication. CORS enabled.",
    "license": { "name": "MIT (code). Data: US SSA, public domain.", "url": "https://github.com/moisesvasquez/us-baby-names/blob/main/LICENSE" }
  },
  "externalDocs": { "url": "https://github.com/moisesvasquez/us-baby-names/blob/main/docs/API.md" },
  "servers": [{ "url": "/" }],
  "paths": {
    "/api": {
      "get": { "summary": "Discovery document listing endpoints", "responses": { "200": { "description": "OK" } } }
    },
    "/api/names/{name}": {
      "get": {
        "summary": "Yearly counts, ranks and summary statistics for one name",
        "parameters": [
          { "name": "name", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[A-Za-z]{1,15}$" }, "example": "Mary" },
          { "$ref": "#/components/parameters/sexAll" },
          { "name": "from", "in": "query", "schema": { "type": "integer", "minimum": 1880, "maximum": 2025, "default": 1880 } },
          { "name": "to", "in": "query", "schema": { "type": "integer", "minimum": 1880, "maximum": 2025, "default": 2025 } }
        ],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NameResponse" } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/top": {
      "get": {
        "summary": "Most popular names for one sex in one year",
        "parameters": [
          { "name": "sex", "in": "query", "required": true, "schema": { "type": "string", "enum": ["F", "M"] } },
          { "name": "year", "in": "query", "schema": { "type": "integer", "minimum": 1880, "maximum": 2025, "default": 2025 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 10 } },
          { "name": "offset", "in": "query", "schema": { "type": "integer", "minimum": 0, "default": 0 } }
        ],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TopResponse" } } } },
          "400": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/search": {
      "get": {
        "summary": "Prefix search, most popular first",
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string", "pattern": "^[A-Za-z]{1,15}$" } },
          { "$ref": "#/components/parameters/sexAll" },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 10 } }
        ],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SearchResponse" } } } },
          "400": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/compare": {
      "get": {
        "summary": "Compare up to four names",
        "parameters": [
          { "name": "names", "in": "query", "required": true, "schema": { "type": "string" }, "example": "Emma,Olivia", "description": "Comma-separated, max 4" },
          { "$ref": "#/components/parameters/sexAll" }
        ],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CompareResponse" } } } },
          "400": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/years/{year}": {
      "get": {
        "summary": "Totals and top names for a single year",
        "parameters": [
          { "name": "year", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1880, "maximum": 2025 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 25, "default": 5 } }
        ],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/YearResponse" } } } },
          "400": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "sexAll": { "name": "sex", "in": "query", "schema": { "type": "string", "enum": ["F", "M", "all"], "default": "all" } }
    },
    "responses": {
      "Error": {
        "description": "Error",
        "content": { "application/json": { "schema": { "type": "object", "properties": { "error": { "type": "object", "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "docs": { "type": "string" } } } } } } }
      }
    },
    "schemas": {
      "Point": { "type": "object", "properties": { "year": { "type": "integer" }, "count": { "type": "integer" }, "rank": { "type": "integer" } } },
      "PointAll": { "type": "object", "properties": { "year": { "type": "integer" }, "count": { "type": "integer" }, "female": { "type": "integer" }, "male": { "type": "integer" } } },
      "Age": { "type": ["object", "null"], "properties": { "mean": { "type": "number" }, "median": { "type": "integer" }, "estimatedLiving": { "type": "integer" } } },
      "Trend": { "type": "object", "properties": { "from": { "type": "integer" }, "to": { "type": "integer" }, "changePct": { "type": ["number", "null"] }, "direction": { "type": "string", "enum": ["rising", "falling", "steady", "new", "gone", "none"] } } },
      "Summary": {
        "type": ["object", "null"],
        "properties": {
          "total": { "type": "integer" },
          "firstYear": { "type": "integer" },
          "lastYear": { "type": "integer" },
          "peak": { "type": "object", "properties": { "year": { "type": "integer" }, "count": { "type": "integer" } } },
          "bestRank": { "type": "object", "properties": { "rank": { "type": "integer" }, "year": { "type": "integer" } } },
          "latest": { "type": ["object", "null"], "properties": { "year": { "type": "integer" }, "count": { "type": "integer" }, "rank": { "type": "integer" } } },
          "trend": { "$ref": "#/components/schemas/Trend" },
          "estimatedAge": { "$ref": "#/components/schemas/Age" }
        }
      },
      "NameResponse": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "sex": { "type": "string", "enum": ["F", "M", "all"] },
          "totals": { "type": "object", "properties": { "female": { "type": "integer" }, "male": { "type": "integer" }, "all": { "type": "integer" } } },
          "female": { "$ref": "#/components/schemas/Summary" },
          "male": { "$ref": "#/components/schemas/Summary" },
          "estimatedAge": { "$ref": "#/components/schemas/Age" },
          "range": { "type": "object", "properties": { "from": { "type": "integer" }, "to": { "type": "integer" } } },
          "years": { "type": "array", "items": { "oneOf": [{ "$ref": "#/components/schemas/Point" }, { "$ref": "#/components/schemas/PointAll" }] } }
        }
      },
      "TopResponse": {
        "type": "object",
        "properties": {
          "year": { "type": "integer" }, "sex": { "type": "string" }, "births": { "type": "integer" }, "uniqueNames": { "type": "integer" },
          "limit": { "type": "integer" }, "offset": { "type": "integer" },
          "names": { "type": "array", "items": { "type": "object", "properties": { "rank": { "type": "integer" }, "name": { "type": "string" }, "count": { "type": "integer" }, "sharePct": { "type": "number" } } } }
        }
      },
      "SearchResponse": {
        "type": "object",
        "properties": {
          "query": { "type": "string" }, "sex": { "type": "string" },
          "results": { "type": "array", "items": { "type": "object", "properties": { "name": { "type": "string" }, "totals": { "type": "object" }, "firstYear": { "type": "integer" }, "lastYear": { "type": "integer" } } } }
        }
      },
      "CompareResponse": {
        "type": "object",
        "properties": {
          "sex": { "type": "string" },
          "names": { "type": "array", "items": { "type": "object", "properties": {
            "name": { "type": "string" }, "found": { "type": "boolean" }, "total": { "type": "integer" },
            "peak": { "type": "object" }, "bestRank": { "type": ["object", "null"] }, "latest": { "type": ["object", "null"] },
            "trend": { "oneOf": [{ "$ref": "#/components/schemas/Trend" }, { "type": "null" }] }, "estimatedAge": { "$ref": "#/components/schemas/Age" },
            "years": { "type": "array" }
          } } }
        }
      },
      "YearResponse": {
        "type": "object",
        "properties": {
          "year": { "type": "integer" }, "births": { "type": "integer" },
          "female": { "type": "object", "properties": { "births": { "type": "integer" }, "uniqueNames": { "type": "integer" }, "top": { "type": "array" } } },
          "male": { "type": "object", "properties": { "births": { "type": "integer" }, "uniqueNames": { "type": "integer" }, "top": { "type": "array" } } }
        }
      }
    }
  }
}
